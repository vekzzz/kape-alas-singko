# Base URL of the API (menu, shop hours, pickup times). In dev it defaults to http://localhost:3000.
# Vite bakes this in at build time, so set it before building for production.
VITE_API_URL=http://localhost:3000

# Webhook that receives placed orders as JSON (sent with Content-Type text/plain to avoid a CORS preflight).
# Orders still go here until the order endpoints land (slice 3); the bundled API no longer accepts them.
# Leave unset and customers are told to show their order at the counter instead.
VITE_ORDER_ENDPOINT=
