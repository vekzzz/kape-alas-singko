# Postgres connection string (Render, Neon, Supabase, or local).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kape
# Set to "true" for hosted Postgres that requires SSL (Render, Neon, Supabase).
DATABASE_SSL=false
# Port the API listens on (Render sets PORT itself).
PORT=3000
# Where the frontend is served from; allowed by CORS. Use * only for local testing.
FRONTEND_ORIGIN=http://localhost:5173
# Secret the bar staff use to list and update orders. Generate a long random value.
STAFF_TOKEN=change-me
