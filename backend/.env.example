# Postgres connection string (Neon, Render, Supabase, or the local docker compose database).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/kape
# Database the integration tests run against. It is created for you if it does not exist.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/kape_test
# "true" for hosted Postgres (Neon, Render, Supabase): encrypted, and the server's certificate is checked.
# "no-verify" encrypts without checking it, for a host with a self-signed certificate. "false" for local.
DATABASE_SSL=false
# Optional. With Neon, DATABASE_URL is the pooled string and this is the direct one, used for migrate/seed/staff:create.
# MIGRATION_DATABASE_URL=
# Port the API listens on (Render sets PORT itself).
PORT=3000
# Where the frontend is served from; allowed by CORS. Comma-separate several origins.
FRONTEND_ORIGIN=http://localhost:5173
# info, debug, warn, error, silent
LOG_LEVEL=info
# Set to "true" behind a proxy such as Render, so the order rate limit counts real visitors.
TRUST_PROXY=false
