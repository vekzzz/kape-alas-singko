# Postgres connection string (Neon, Render, Supabase, or the local docker compose database).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/kape
# Database the integration tests run against. It is created for you if it does not exist.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/kape_test
# Set to "true" for hosted Postgres that requires SSL (Neon, Render, Supabase).
DATABASE_SSL=false
# Port the API listens on (Render sets PORT itself).
PORT=3000
# Where the frontend is served from; allowed by CORS. Comma-separate several origins.
FRONTEND_ORIGIN=http://localhost:5173
# info, debug, warn, error, silent
LOG_LEVEL=info
