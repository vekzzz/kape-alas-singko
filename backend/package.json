{
  "name": "kape-alas-singko-backend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "db:generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "staff:create": "tsx --env-file-if-exists=.env src/staffCreate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@kape/contract": "*",
    "@node-rs/argon2": "^2.0.2",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.13.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "tsx": "^4.19.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^7.2.0",
    "drizzle-kit": "^0.31.0",
    "supertest": "^7.1.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0"
  }
}
